{
  "manifest_version": 3,
  "name": "VimText",
  "version": "0.4.0",
  "description": "Vim modal editing for the text fields of ordinary web pages: edits the page's own field in place, no native host.",
  "homepage_url": "https://github.com/Kyu-seok/VimText",
  "permissions": ["storage", "clipboardRead", "clipboardWrite"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VimText",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
