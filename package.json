{
  "name": "vimtext",
  "version": "0.1.0",
  "description": "Vim modal editing for the text fields of ordinary web pages (Chrome MV3 extension).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node tools/make-icons.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@replit/codemirror-vim": "6.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@vitest/browser": "3.2.7",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  }
}
