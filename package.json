{
  "name": "vimtext",
  "version": "0.3.0",
  "description": "Vim modal editing for the text fields of ordinary web pages (Chrome MV3 extension).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check:imports": "node tools/check-imports.mjs",
    "check:unused": "knip",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "npm run build && playwright test --config playwright.screenshots.config.ts",
    "package": "node tools/package.mjs",
    "check": "npm run typecheck && npm run check:imports && npm run check:unused && npm test && npm run test:e2e",
    "icons": "node tools/make-icons.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@replit/codemirror-vim": "6.4.0"
  },
  "devDependencies": {
    "@lexical/history": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "3.2.7",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "knip": "6.44.2",
    "lexical": "0.53.0",
    "lint-staged": "17.6.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.8",
    "quill": "2.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  }
}
